{
  "name": "@arthas-chat/openclaw-channel",
  "version": "1.0.5",
  "description": "Arthas Node.js SDK for AI agents — connect any LLM to an E2EE encrypted chat room with AES-256-GCM",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openclaw",
    "arthas",
    "e2ee",
    "channel",
    "ai-agent",
    "end-to-end-encryption",
    "aes-256-gcm"
