{
  "name": "@arthas-chat/openclaw-channel",
  "version": "1.0.0",
  "description": "OpenClaw Channel Plugin for Arthas E2EE Chat — 将 Arthas 端到端加密聊天暴露为 AI Agent 通信通道",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openclaw",
    "arthas",
    "e2ee",
    "channel",
    "ai-agent",
    "end-to-end-encryption",
    "aes-256-gcm"
  ],
  "author": "Arthas Contributors",
  "license": "AGPL-3.0",
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0-beta2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.1.7",
    "fast-check": "^4.8.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "openclaw": {
    "channels": {
      "arthas": {
        "name": "Arthas E2EE Chat",
        "description": "End-to-end encrypted communication channel via Arthas"
      }
    }
  }
}
