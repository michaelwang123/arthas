---
/**
 * Footer �?全站页脚组件
 *
 * 本组件在每个页面底部渲染，提供项目关键链接和版权信息�?
 * 作为全站导航的补充，页脚确保用户在任何位置都能快速访问：
 * - GitHub 仓库（查看源码、提�?Issue�?
 * - AGPL-3.0 许可证（了解开源协议）
 * - Launch App 按钮（直接使�?Arthas 应用�?
 *
 * 📚 学习要点: 页脚�?SEO 与可访问性价�?
 * - 使用语义�?<footer> 元素，屏幕阅读器可识别为页面页脚区域
 * - 外部链接使用 rel="noopener" 防止 window.opener 安全漏洞
 * - target="_blank" 仅用于外部链接（Launch App），内部链接保持同窗口导�?
 * - 链接使用 --color-accent 强调色，确保在暗色背景上对比�?> 4.5:1
 *
 * 与其他模块的关系�?
 * - �?Landing.astro 布局和各页面引用，渲染在 <main> 之后
 * - 依赖 src/i18n/utils.ts 获取当前语言的翻译文�?
 * - 使用 src/styles/global.css 中定义的 CSS 变量
 */

import { t, getLocaleFromUrl, baseWithSlash } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
---

<footer class="site-footer">
  <div class="footer-content">
    {/* 📚 学习要点: 导航链接分组
        使用 <nav> 包裹页脚链接，语义上表明这是导航区域�?
        aria-label 区分页头和页脚的 <nav>，避免屏幕阅读器混淆�?*/}
    <nav class="footer-links" aria-label="Footer navigation">
      <a
        href="https://github.com/michaelwang123/arthas"
        target="_blank"
        rel="noopener"
        class="footer-link"
      >
        {t('footer.github', locale)}
      </a>

      <span class="footer-separator" aria-hidden="true">·</span>

      <a
        href="https://www.gnu.org/licenses/agpl-3.0.html"
        target="_blank"
        rel="noopener"
        class="footer-link"
      >
        {t('footer.license', locale)}
      </a>

      <span class="footer-separator" aria-hidden="true">·</span>

      {/* 📚 学习要点: 内部页面链接
          Download �?Roadmap 链接使用 import.meta.env.BASE_URL 前缀�?
          确保在子目录部署�?arthas/）下路径正确�?
          根据当前语言动态生成对应语言版本�?URL�?*/}
      <a
        href={locale === 'zh' ? `${baseWithSlash}zh/download/` : `${baseWithSlash}download/`}
        class="footer-link"
      >
        {t('footer.download', locale)}
      </a>

      <span class="footer-separator" aria-hidden="true">·</span>

      <a
        href={locale === 'zh' ? `${baseWithSlash}zh/roadmap/` : `${baseWithSlash}roadmap/`}
        class="footer-link"
      >
        {t('footer.roadmap', locale)}
      </a>

      <span class="footer-separator" aria-hidden="true">·</span>

      {/* 📚 学习要点: Launch App 安全属�?
          target="_blank" 在新标签页打开外部应用，避免用户离开文档站�?
          rel="noopener" 阻止新页面通过 window.opener 访问原页面，
          防止潜在�?tabnabbing 攻击（恶意页面修改原页面 URL）�?*/}
      <a
        href="https://arthas-blush.vercel.app"
        target="_blank"
        rel="noopener"
        class="footer-link footer-launch"
      >
        {t('footer.launch', locale)} �?
      </a>
    </nav>

    <p class="footer-copyright">
      {t('footer.copyright', locale)}
    </p>
  </div>
</footer>

<style>
  /* ==========================================================================
     Footer 样式 �?居中布局，链接行 + 版权信息
     ========================================================================== */

  .site-footer {
    background-color: var(--color-bg-surface);
    border-top: 1px solid var(--color-hairline);
    padding: 2rem 1.5rem;
    margin-top: auto;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  /* 链接�?�?水平排列，居�?*/
  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-link {
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.9rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    /* 确保移动端最小触摸目�?44x44px */
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .footer-link:hover {
    color: var(--color-accent-high, #ffe44d);
    background-color: var(--color-hover-bg);
  }

  .footer-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Launch App 按钮 �?视觉上稍微突�?*/
  .footer-launch {
    font-weight: 600;
  }

  .footer-separator {
    color: var(--color-text-secondary);
    user-select: none;
  }

  /* 版权文本 */
  .footer-copyright {
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    margin: 0;
    line-height: 1.5;
  }

  /* 响应式：移动端增加间�?*/
  @media (max-width: 767px) {
    .site-footer {
      padding: 1.5rem 1rem;
    }

    .footer-links {
      gap: 0.5rem;
    }

    .footer-link {
      font-size: 1rem;
    }

    /* 📚 学习要点: 移动端最小字�?16px (Req 4.3)
       版权文本在移动端提升�?1rem (16px)�?
       确保所有可见文本满足最小字体要求�?*/
    .footer-copyright {
      font-size: 1rem;
    }
  }
</style>
