---
/**
 * TrustSection — 安全信任展示组件
 *
 * 本组件展示 Arthas 的 4 个核心信任指标，帮助访客建立对产品安全性的信心。
 * 在加密通信产品中，信任是用户决策的关键因素 — 本区域通过具体证据
 * （开源代码、零知识架构、法律保障、技术实现）消除用户疑虑。
 *
 * 📚 学习要点: 信任建设的 4 层模型
 * 1. 开源透明 — "代码公开，你可以自己验证"（技术信任）
 * 2. 零知识架构 — "服务器看不到你的数据"（架构信任）
 * 3. AGPL-3.0 — "法律保证衍生作品也必须开源"（法律信任）
 * 4. 客户端加密 — "密钥永远不离开你的设备"（实现信任）
 *
 * 与其他模块的关系：
 * - 被 src/pages/index.astro 和 src/pages/zh/index.astro 引用
 * - 使用 src/i18n/utils.ts 的 t() 函数获取多语言文案
 * - 引用 src/styles/global.css 中定义的 CSS 变量
 */

import { t, getLocaleFromUrl } from '../i18n/utils';
import type { Locale } from '../i18n/utils';

/**
 * 组件 Props 接口
 * @property locale - 可选的语言标识符，若未提供则从 URL 自动检测
 */
interface Props {
  locale?: Locale;
}

const { locale: propLocale } = Astro.props;
const locale = propLocale ?? getLocaleFromUrl(Astro.url);

/**
 * 📚 学习要点: 数据驱动的信任指标
 * 将信任指标抽取为数组，保持模板简洁且易于维护。
 * 每个指标包含：图标（emoji）、标题 key、描述 key。
 * 未来可扩展为包含链接（如 GitHub 仓库、许可证页面）。
 */
const trustItems = [
  {
    icon: '🌐',
    titleKey: 'trust.opensource.title',
    descKey: 'trust.opensource.description',
    link: 'https://github.com/michaelwang123/arthas',
  },
  {
    icon: '🔐',
    titleKey: 'trust.zeroknowledge.title',
    descKey: 'trust.zeroknowledge.description',
    link: null,
  },
  {
    icon: '⚖️',
    titleKey: 'trust.agpl.title',
    descKey: 'trust.agpl.description',
    link: 'https://www.gnu.org/licenses/agpl-3.0.html',
  },
  {
    icon: '🛡️',
    titleKey: 'trust.servernothing.title',
    descKey: 'trust.servernothing.description',
    link: null,
  },
];
---

<section class="trust-section" aria-labelledby="trust-heading">
  <h2 id="trust-heading" class="section-title">
    {t('trust.title', locale)}
  </h2>

  <div class="trust-grid">
    {trustItems.map((item) => (
      <article class="trust-card">
        <span class="trust-icon" aria-hidden="true">{item.icon}</span>
        <h3 class="trust-title">{t(item.titleKey, locale)}</h3>
        <p class="trust-description">{t(item.descKey, locale)}</p>
        {item.link && (
          <a
            href={item.link}
            target="_blank"
            rel="noopener"
            class="trust-link"
          >
            →
          </a>
        )}
      </article>
    ))}
  </div>

  {/* 📚 学习要点: 简化架构图
      使用 ASCII/文字表示加密流程，比 SVG 更易维护且无外部依赖。
      Client → 🔒 Encrypt → Server (blind relay) → 🔓 Decrypt → Client */}
  <div class="architecture-diagram" aria-label="Zero-knowledge architecture flow">
    <div class="diagram-flow">
      <span class="diagram-node">Client</span>
      <span class="diagram-arrow" aria-hidden="true">→</span>
      <span class="diagram-node diagram-encrypt">🔒 Encrypt</span>
      <span class="diagram-arrow" aria-hidden="true">→</span>
      <span class="diagram-node diagram-server">Server (blind relay)</span>
      <span class="diagram-arrow" aria-hidden="true">→</span>
      <span class="diagram-node diagram-decrypt">🔓 Decrypt</span>
      <span class="diagram-arrow" aria-hidden="true">→</span>
      <span class="diagram-node">Client</span>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     TrustSection 组件样式
     ========================================================================== */

  .trust-section {
    padding: 4rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    text-align: center;
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 3rem;
  }

  /* 信任卡片网格 — 2x2 布局 */
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .trust-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-hairline);
    border-radius: 12px;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: transform 250ms ease-out, box-shadow 250ms ease-out;
  }

  .trust-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(255, 215, 0, 0.06);
  }

  .trust-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .trust-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0.5rem 0 0 0;
  }

  .trust-description {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .trust-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-accent);
    font-size: 1.25rem;
    text-decoration: none;
    border-radius: 6px;
    margin-top: 0.5rem;
    align-self: flex-start;
  }

  .trust-link:hover {
    background-color: rgba(255, 215, 0, 0.1);
  }

  .trust-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* --------------------------------------------------------------------------
     架构图 — 水平流程展示
     -------------------------------------------------------------------------- */

  .architecture-diagram {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-hairline);
    border-radius: 12px;
    padding: 2rem;
    overflow-x: auto;
  }

  .diagram-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    min-width: fit-content;
  }

  .diagram-node {
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-hairline);
    white-space: nowrap;
  }

  .diagram-encrypt,
  .diagram-decrypt {
    color: var(--color-accent);
    border-color: rgba(255, 215, 0, 0.3);
    background: rgba(255, 215, 0, 0.05);
  }

  .diagram-server {
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .diagram-arrow {
    color: var(--color-accent);
    font-size: 1.25rem;
    opacity: 0.7;
  }

  /* --------------------------------------------------------------------------
     响应式 — 移动端
     -------------------------------------------------------------------------- */

  @media (max-width: 767px) {
    .trust-section {
      padding: 3rem 1rem;
    }

    .section-title {
      font-size: 1.5rem;
      margin-bottom: 2rem;
    }

    /* 移动端单列 */
    .trust-grid {
      grid-template-columns: 1fr;
    }

    .trust-card {
      padding: 1.5rem 1.25rem;
    }

    /* 📚 学习要点: 移动端最小字体 16px (Req 4.3)
       信任描述文本在移动端提升至 1rem (16px)，确保可读性。 */
    .trust-description {
      font-size: 1rem;
    }

    .architecture-diagram {
      padding: 1.5rem 1rem;
    }

    .diagram-flow {
      justify-content: flex-start;
    }

    .diagram-node {
      font-size: 1rem;
    }
  }
</style>
