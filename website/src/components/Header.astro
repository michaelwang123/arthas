    color: var(--color-accent, #ffd700);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: background-color 200ms ease-out, color 200ms ease-out;
  }

  .mobile-nav-star:hover {
    background-color: var(--color-accent, #ffd700);
