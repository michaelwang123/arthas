  }

  /* ===== 全屏导航抽屉样式 ===== */

  /*
   * 📚 学习要点: 全屏导航抽屉的 CSS 架构
   * 抽屉使用 fixed 定位覆盖整个视口，z-index 高于 header。
   * 动画策略：
   * - 默认状态：opacity: 0 + 面板 translateX(100%)（在右侧屏幕外）
   * - 打开状态（[data-open]）：opacity: 1 + translateX(0)
   * - transition 驱动平滑动画（250ms）
   * - hidden 属性在动画完成后由 JS 添加/移除
   *
   * 为什么不用 display: none 控制显隐？
   * 因为 display 属性不支持 transition，切换时无法产生动画效果。
   * 使用 hidden + opacity + transform 的组合可以兼顾动画和无障碍。
   */
  .mobile-nav-drawer {
    position: fixed;
    inset: 0;
    z-index: 200;
    opacity: 0;
    transition: opacity 250ms ease-out;
    pointer-events: none;
  }

  .mobile-nav-drawer[data-open] {
    opacity: 1;
    pointer-events: auto;
  }

  /* 遮罩层 — 半透明黑色背景 */
  .mobile-nav-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
  }

  /*
   * 导航面板 — 从右侧滑入的全屏面板
   * 📚 学习要点: transform 动画性能
   * 使用 transform: translateX() 而非 left/right 属性做动画，
   * 因为 transform 不触发 layout reflow，只触发 composite，
   * GPU 加速使动画在 60fps 下流畅运行。
   */
  .mobile-nav-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 100vw;
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-primary, #0d0d1a);
    transform: translateX(100%);
    transition: transform 250ms ease-out;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-nav-drawer[data-open] .mobile-nav-panel {
    transform: translateX(0);
  }

  /* 抽屉头部 — Logo + 关闭按钮 */
  .mobile-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-hairline, rgba(255, 255, 255, 0.1));
  }

  /*
