  /* 移动端 GitHub Star 按钮 */
  .mobile-nav-star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-accent, #ffd700);
