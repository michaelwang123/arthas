    padding: 0.5rem 0.25rem;
    transition: color 200ms ease-out;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  /*
   * 📚 学习要点: Active 导航项视觉区分
   * 满足 Requirement 10.3 — 当前页面的导航项必须与其他项有明确的视觉区别。
   * 使用三重信号确保无歧义：
   * 1. 颜色变化（accent gold）— 最直观的视觉信号
   * 2. 字重加粗（600）— 增加视觉重量
   * 3. 底部下划线（::after 伪元素）— 额外的位置指示
   * 这种多信号设计确保色盲用户也能识别 active 状态。
   */
  .nav-link.active {
    color: var(--color-accent);
