    outline-offset: 2px;
  }

  /* 导航链接列表 — 垂直排列，大间距 */
  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
    gap: 0.5rem;
    flex: 1;
  }

  /*
   * 移动端导航链接
   * 📚 学习要点: 移动端触摸目标的最佳实践
   * - min-height: 48px（超过 WCAG 最低要求的 44px）
   * - 大 padding 增加可点击区域
   * - 大字号（1.125rem）提升可读性
   * - 圆角背景在 hover/active 时出现，提供触摸反馈
   */
  .mobile-nav-link {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0.75rem 1rem;
    color: var(--color-text-secondary, #a0a0b0);
    text-decoration: none;
    font-size: 1.125rem;
    font-weight: 500;
    border-radius: 8px;
    transition: color 200ms ease-out, background-color 200ms ease-out;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:active {
    color: var(--color-text-primary, #e8e8e8);
    background-color: rgba(255, 255, 255, 0.05);
  }

  .mobile-nav-link.active {
    color: var(--color-accent, #ffd700);
    font-weight: 600;
    background-color: rgba(255, 215, 0, 0.05);
  }

  /* 抽屉底部 — 语言切换 + GitHub Star */
  .mobile-nav-footer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 1rem;
    border-top: 1px solid var(--color-hairline, rgba(255, 255, 255, 0.1));
