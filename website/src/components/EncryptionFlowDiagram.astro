---
/**
 * EncryptionFlowDiagram — Inline animated SVG showing E2EE encryption flow.
 * Arrows have flowing dashes, encrypt/decrypt boxes have shimmer glow.
 */
---

<section class="enc-section" aria-label="Encryption Flow">
  <div class="enc-container">
    <svg class="enc-svg" viewBox="0 0 900 360" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <marker id="eArrG" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 Z" fill="#ffd700"/></marker>
        <filter id="eShadow"><feDropShadow dx="0" dy="2" stdDeviation="3" flood-opacity="0.25"/></filter>
      </defs>

      <rect width="900" height="360" rx="12" fill="#0d0d1a"/>
      <text x="450" y="32" text-anchor="middle" font-family="Inter, sans-serif" font-size="16" font-weight="700" fill="#ffd700">End-to-End Encryption Flow</text>

      <!-- Sender -->
      <rect x="30" y="60" width="230" height="270" rx="10" fill="#1a1a2e" stroke="#4a7fbf" stroke-width="1.5" filter="url(#eShadow)"/>
      <text x="145" y="84" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" font-weight="600" fill="#4a7fbf">👤 Sender (Alice)</text>
      <rect x="50" y="100" width="190" height="34" rx="6" fill="#1e293b"/><text x="145" y="121" text-anchor="middle" font-family="monospace" font-size="10" fill="#e8e8e8">① "Hello Bob!" (plaintext)</text>
      <rect x="50" y="145" width="190" height="34" rx="6" fill="#1e293b"/><text x="145" y="166" text-anchor="middle" font-family="monospace" font-size="10" fill="#94a3b8">② Random IV (12 bytes)</text>
      <rect class="enc-box" x="50" y="190" width="190" height="40" rx="6" fill="rgba(255,215,0,0.1)" stroke="#ffd700" stroke-width="1"/>
      <text x="145" y="207" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" font-weight="600" fill="#ffd700">③ AES-256-GCM Encrypt</text>
      <text x="145" y="222" text-anchor="middle" font-family="monospace" font-size="9" fill="#94a3b8">roomKey + IV + plaintext</text>
      <rect x="50" y="243" width="190" height="34" rx="6" fill="#1e293b"/><text x="145" y="264" text-anchor="middle" font-family="monospace" font-size="10" fill="#ef4444">④ {iv, ciphertext} →</text>
      <rect x="55" y="290" width="180" height="24" rx="12" fill="rgba(34,197,94,0.1)" stroke="#22c55e" stroke-width="1"/><text x="145" y="306" text-anchor="middle" font-family="monospace" font-size="9" fill="#22c55e">🔑 roomKey stays local</text>

      <!-- Server -->
      <rect class="server-node" x="330" y="120" width="240" height="160" rx="10" fill="#1a1a2e" stroke="#ffd700" stroke-width="1.5" filter="url(#eShadow)"/>
      <text x="450" y="146" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" font-weight="600" fill="#ffd700">⚡ Server (Blind Relay)</text>
      <rect x="350" y="160" width="200" height="34" rx="6" fill="#1e293b"/><text x="450" y="181" text-anchor="middle" font-family="monospace" font-size="10" fill="#94a3b8">Receives: {iv, ciphertext}</text>
      <rect x="350" y="205" width="200" height="34" rx="6" fill="rgba(239,68,68,0.1)" stroke="#ef4444" stroke-width="1"/><text x="450" y="226" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" font-weight="600" fill="#ef4444">❌ Cannot decrypt</text>
      <rect x="350" y="250" width="200" height="34" rx="6" fill="#1e293b"/><text x="450" y="271" text-anchor="middle" font-family="monospace" font-size="10" fill="#94a3b8">Forwards: {iv, ciphertext}</text>

      <!-- Receiver -->
      <rect x="640" y="60" width="230" height="270" rx="10" fill="#1a1a2e" stroke="#22c55e" stroke-width="1.5" filter="url(#eShadow)"/>
      <text x="755" y="84" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" font-weight="600" fill="#22c55e">👤 Receiver (Bob)</text>
      <rect x="660" y="100" width="190" height="34" rx="6" fill="#1e293b"/><text x="755" y="121" text-anchor="middle" font-family="monospace" font-size="10" fill="#ef4444">⑤ ← {iv, ciphertext}</text>
      <rect class="enc-box" x="660" y="145" width="190" height="40" rx="6" fill="rgba(255,215,0,0.1)" stroke="#ffd700" stroke-width="1"/>
      <text x="755" y="162" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" font-weight="600" fill="#ffd700">⑥ AES-256-GCM Decrypt</text>
      <text x="755" y="177" text-anchor="middle" font-family="monospace" font-size="9" fill="#94a3b8">roomKey + IV + ciphertext</text>
      <rect x="660" y="198" width="190" height="34" rx="6" fill="#1e293b"/><text x="755" y="219" text-anchor="middle" font-family="monospace" font-size="10" fill="#e8e8e8">⑦ "Hello Bob!" (plaintext)</text>
      <rect x="660" y="243" width="190" height="34" rx="6" fill="rgba(168,85,247,0.1)" stroke="#a855f7" stroke-width="1"/><text x="755" y="264" text-anchor="middle" font-family="monospace" font-size="10" fill="#a855f7">⑧ Ed25519 verify ✓</text>
      <rect x="665" y="290" width="180" height="24" rx="12" fill="rgba(34,197,94,0.1)" stroke="#22c55e" stroke-width="1"/><text x="755" y="306" text-anchor="middle" font-family="monospace" font-size="9" fill="#22c55e">🔑 Same roomKey</text>

      <!-- Animated flow arrows -->
      <path class="flow-arrow flow-arrow-1" d="M260 210 L330 200" stroke="#ffd700" stroke-width="2" stroke-dasharray="6 3" marker-end="url(#eArrG)"/>
      <path class="flow-arrow flow-arrow-2" d="M570 220 L640 170" stroke="#ffd700" stroke-width="2" stroke-dasharray="6 3" marker-end="url(#eArrG)"/>

      <!-- Moving dots along arrows -->
      <circle class="flow-dot dot-1" cx="260" cy="210" r="3" fill="#ffd700"/>
      <circle class="flow-dot dot-2" cx="570" cy="220" r="3" fill="#ffd700"/>

      <text x="450" y="345" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#64748b">Key exchange happens out-of-band via share code — server never sees the key</text>
    </svg>
  </div>
</section>

<style>
  .enc-section {
    padding: 2rem 1.5rem 4rem;
    max-width: 960px;
    margin: 0 auto;
  }

  .enc-container {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0,0,0,0.4);
  }

  .enc-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Flowing dashes on arrows */
  .flow-arrow {
    animation: enc-dash 1.5s linear infinite;
  }
  .flow-arrow-2 { animation-delay: 0.4s; }

  @keyframes enc-dash {
    to { stroke-dashoffset: -18; }
  }

  /* Moving dots along the arrow paths */
  .flow-dot {
    opacity: 0;
    animation: dot-travel 2.5s ease-in-out infinite;
  }
  .dot-1 {
    animation-name: dot-travel-1;
  }
  .dot-2 {
    animation-name: dot-travel-2;
    animation-delay: 1s;
  }

  @keyframes dot-travel-1 {
    0%   { cx: 260; cy: 210; opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { cx: 325; cy: 201; opacity: 0; }
  }

  @keyframes dot-travel-2 {
    0%   { cx: 570; cy: 220; opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { cx: 635; cy: 172; opacity: 0; }
  }

  /* Shimmer glow on encrypt/decrypt boxes */
  .enc-box {
    animation: enc-shimmer 3s ease-in-out infinite;
  }

  @keyframes enc-shimmer {
    0%, 100% { filter: none; }
    50% { filter: drop-shadow(0 0 6px rgba(255,215,0,0.4)); }
  }

  /* Server node subtle pulse */
  .server-node {
    animation: srv-pulse 4s ease-in-out infinite;
  }

  @keyframes srv-pulse {
    0%, 100% { filter: url(#eShadow); }
    50% { filter: url(#eShadow) drop-shadow(0 0 6px rgba(255,215,0,0.2)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-arrow, .flow-dot, .enc-box, .server-node {
      animation: none;
    }
    .flow-dot { opacity: 0; }
  }
</style>
